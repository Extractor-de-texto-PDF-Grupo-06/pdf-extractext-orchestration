# Copiar como .env y completar. El archivo .env NO se versiona.
#   cp .env.example .env

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Obligatoria. Solo letras y números: va dentro de la URL de conexión de documents.
MONGO_ROOT_PASSWORD=
MONGO_ROOT_USERNAME=admin
MONGODB_DB_NAME=pdf_extractext

# ── Imágenes ─────────────────────────────────────────────────────────────────
# Etiqueta de las imágenes de ghcr: latest o el hash de un commit.
IMAGE_TAG=latest

# ── Puertos de la máquina (los únicos que se publican, los de Traefik) ───────
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_RATE_LIMIT_AVERAGE=100
TRAEFIK_RATE_LIMIT_BURST=200
TRAEFIK_RETRY_ATTEMPTS=3

# ── extractor ────────────────────────────────────────────────────────────────
EXTRACTOR_REPLICAS=5
EXTRACTOR_MAX_FILE_SIZE_MB=10

# ── web ──────────────────────────────────────────────────────────────────────
# Valores iniciales que config-seed carga en Consul, y respaldo de web si config no
# responde. Después de la primera carga, se cambian en caliente por config:
#   curl -X PUT http://localhost/config/web/max_file_size_mb \
#        -H "Content-Type: application/json" -d '{"value": "20"}'
WEB_MAX_FILE_SIZE_MB=10
WEB_EXTRACTOR_TIMEOUT_SECONDS=30
WEB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
WEB_CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
